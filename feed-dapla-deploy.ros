#!/bin/sh
#|-*- mode:lisp -*-|#
#|
exec ros -Q -- $0 "$@"
|#
(progn
  (ros:ensure-asdf)
  (asdf:load-asd (merge-pathnames "feed-dapla-deploy.asd" *load-pathname*))
  #+quicklisp
  (let ((needed '(:cl-inix :consfigurator :fiveam :dexador)))
    (unless (every #'ql-dist:find-system (mapcar #'string-downcase needed))
      (ql-dist:install-dist "http://dist.ultralisp.org/" :prompt nil))
    (ql:quickload (list* :feed-dapla-deploy/deploy :feed-dapla-deploy/e2e needed)
                  :silent t)))

(declaim (optimize (speed 3) (safety 1) (debug 1)))

(defpackage :ros.script.feed-dapla-deploy.3167498364
  (:use :cl :feed-dapla-deploy/deploy :feed-dapla-deploy/e2e)
  (:export #:main))

(in-package :ros.script.feed-dapla-deploy.3167498364)

(defun main (&rest argv)
  "Entry point for `./feed-dapla-deploy.ros [e2e]`. With no arguments,
   provisions the GoToSocial ActivityPub server via DEPLOY-APP. With `e2e`, runs RUN-E2E
   against whatever is already deployed."
  (consfigurator:in-consfig :feed-dapla-deploy/deploy)
  (cond
    ((member "e2e" argv :test #'string=)
     (run-e2e))
    ((member "decommission" argv :test #'string=)
     (decommissioned *service-user*))
    (t
     (deploy-app))))
;;; vim: set ft=lisp lisp:
